rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow initial setup for roles and permissions
    match /roles/{roleId} {
      allow read: if true;
      allow write: if true;
    }

    match /permissions/{permissionId} {
      allow read: if true;
      allow write: if true;
    }

    match /masterUserData/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Default rule
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
